pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('PULL STAGE') {
            steps {
                git 'https://github.com/Yusuf-tech196/pipeline786.git'
                echo "PULL SUCCESS"
            }
        }

        stage('BUILD STAGE') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn clean package -DskipTests'
                }
                echo "BUILD SUCCESS"
            }
        }

        stage('TEST STAGE') {
            steps {
                // Ensure that the SonarQube installation in Jenkins is named "MySonarQube"
                withSonarQubeEnv('SonarQube') {
                    dir('backend') {
                        sh '''mvn sonar:sonar \
                        -Dsonar.projectKey=my-app786 \
                        -Dsonar.projectName='my-app786' \
                        '''
                    }
                }
                echo "Great TEST SUCCESS"
            }
        }
	
	stage('QUALITY-GATE') {
            steps {
		timeout(time: 5, unit: 'MINUTES') {
		waitForQualityGate abortPipeline: false, credentialsId: 'SonarQube'
                echo "Great DEPLOY SUCCESS"
		}
            }
        }

        stage('DEPLOY STAGE') {
            steps {
                echo "Great DEPLOY SUCCESS"
            }
        }
    }
}
